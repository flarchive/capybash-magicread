{
  "name": "capybash/magicread",
  "description": "Clean pagination inside discussions and a live character counter for the composer.",
  "type": "flarum-extension",
  "keywords": ["flarum", "flarum-extension", "pagination", "composer", "counter", "magic"],
  "license": "MIT",
  "homepage": "https://github.com/capybash/magicread",
  "support": {
    "issues": "https://github.com/capybash/magicread/issues",
    "source": "https://github.com/capybash/magicread",
    "forum": "https://discuss.flarum.org/d/38287-magicread-pagination-live-counter"
  },
  "authors": [
    {
      "name": "capybash",
      "role": "Developer",
      "homepage": "https://github.com/capybash"
    }
  ],
  "require": {
    "php": ">=8.2",
    "flarum/core": "^2.0"
  },
  "autoload": {
    "psr-4": {
      "Capybash\\MagicRead\\": "src/"
    }
  },
  "extra": {
    "branch-alias": {
      "dev-2.x": "2.x-dev"
    },
    "flarum-extension": {
      "title": "Magic Read",
      "category": "feature",
      "icon": {
        "name": "fas fa-hat-wizard",
        "backgroundColor": "#6A5ACD",
        "color": "#ffffff"
      }
    }
  },
  "config": {
    "sort-packages": true
  }
}